<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ZOBAN V10 من رسمتك</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap');
body{background:#f5f5f5;color:#111;font-family:'Cairo';margin:0;padding:8px}
.paper{max-width:750px;margin:auto;background:#fff;border:2px solid #111;border-radius:4px;padding:18px;min-height:900px;position:relative}
.top-oval{width:220px;height:60px;border:2px solid #111;border-radius:0 0 60px 60px / 0 0 40px 40px;margin:0 auto 10px;display:flex;align-items:center;justify-content:center}
.label{font-size:12px;color:#333}
.row{display:flex;gap:12px;justify-content:center;margin:18px 0;flex-wrap:wrap}
.box{border:2px solid #334a8a;min-height:42px;min-width:110px;display:flex;align-items:center;justify-content:center;background:#fff}
.box.small{width:68px;min-width:68px;height:52px}
.box.long{width:420px}
.box.bottom{width:150px;height:44px}
.ticks{font-size:7px;letter-spacing:1px;text-align:center;color:#111}
.center-note{text-align:center;font-size:11px;margin:10px 0;line-height:1.6}
.eyes-row{display:flex;gap:40px;justify-content:center;margin-top:30px}
.eye-col{text-align:center}
.eye-col .box{margin:auto}
.icon{font-size:32px;margin-top:10px}
textarea{width:100%;height:70px;border:2px solid #d4af37;border-radius:10px;text-align:center;font-size:18px;direction:ltr;margin-top:10px}
button{background:#111;color:#f3d24a;border:none;padding:8px 14px;border-radius:8px;margin:4px;font-family:'Cairo';font-weight:700;cursor:pointer}
</style>
</head>
<body>
<div class="paper">
<div class="top-oval"><span class="label">فتاح الرزق</span></div>

<div class="row"><div class="box" style="width:170px"><span class="label">رية</span></div><div class="box" style="width:170px"><span class="label">رية</span></div></div>

<div class="row" style="align-items:flex-end">
<div><div class="label" style="text-align:center">↓ البلوك &nbsp; الضلع ↓</div><div style="display:flex;gap:8px"><div class="box small"></div><div class="box small"></div></div><div style="display:flex;gap:22px;justify-content:center;margin-top:4px"><span>٦</span><span>٢</span></div></div>
<div><div class="label" style="text-align:center">↓ الرتبة</div><div class="ticks">١٨ ١٧ ١٦ ١٥ ١٤ ١٣ ١٢ ١١ ١٠ ٩ ٨ ٧ ٦ ٥ ٤ ٣ ٢ ١</div><div class="box long"></div></div>
</div>

<div class="center-note">
الريشة ١٨ خانة<br>أصغر عدد<br>٤٢٩,٤٩٠,٨١٧,٦٦٤٠...<br>٤٢٩,٤٩٠,٨١٧,٦٦٤٠...
</div>

<div class="eyes-row">
<div class="eye-col"><div style="display:flex;align-items:center;gap:6px"><span>← الفرع</span><div class="box bottom"></div></div><div class="label" style="margin-top:8px">الهرم<br>٩٩٩</div><div class="icon">◊</div></div>
<div class="eye-col"><div class="box bottom"></div><div class="label" style="margin-top:18px">الهلال<br>٩٩٩</div><div class="icon">☾</div></div>
<div class="eye-col"><div class="box bottom"></div><div class="label" style="margin-top:18px">الخرطوش<br>٩٩٩</div><div class="icon" style="font-size:40px">🏺</div><div style="font-size:9px;text-align:right">مدخل الزلطه<br>من الست</div></div>
</div>

<textarea id="big">1</textarea>
<div style="text-align:center"><button onclick="addZ(1000)">+1000 صفر</button><button onclick="addZ(100000)">+100 ألف صفر</button><button onclick="doHouse()">سكن</button></div>
<div id="out" style="text-align:center;font-size:12px;margin-top:8px;color:#111"></div>
</div>
<script>
const big=document.getElementById('big');
function clean(s){return s.replace(/[^0-9]/g,'')||'0'}
function addZ(n){big.value=(clean(big.value)||'1')+'0'.repeat(n);doHouse()}
function doHouse(){
let s=clean(big.value);let L=s.length;let q=Math.floor((L-1)/18);
document.getElementById('out').innerHTML=L.toLocaleString()+' خانة = '+q.toLocaleString()+' بلوك';
}
big.addEventListener('input',doHouse);doHouse();
</script>
</body>
</html>
